{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "google/gemini-3.1-flash-lite",
  "instructions": [
    "~/.omo/instructions/codegraph.md"
  ],
  "lsp": true,
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "opencode-ntfy.sh@latest",
    "oh-my-openagent@latest",
    "zhzy0077/opencode-terminal-title@latest",
  ],
  "provider": {
    "google": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 1200000
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "doom_loop": "deny",
    "external_directory": "allow",
    "bash": {
      "rm * ": "deny"
    }
  }
}
