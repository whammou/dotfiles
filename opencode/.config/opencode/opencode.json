{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-ntfy.sh",
    "oh-my-openagent",
    "opencode-sessions"
  ],
  "permission": {
    "read": "allow",
    "edit": "ask",
    "external_directory": "allow",
    "bash": {
      "rm * ": "deny"
    }
  },
  "mcp": {
    "opsys.note": {
      "type": "remote",
      "enabled": true,
      "url": "https://gitmcp.io/whammou/opsys.note"
    },
    "notes.note": {
      "type": "remote",
      "enabled": true,
      "url": "https://gitmcp.io/whammou/notes.note"
    }
  }
}
