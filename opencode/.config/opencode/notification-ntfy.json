{
  "$schema": "node_modules/opencode-ntfy.sh/notification-ntfy.schema.json",
  "backend": {
    "server": "https://ntfy.whammou.dedyn.io",
    "token": "{file:~/.secrets/ntfy-token}",
    "topic": "opencode",
    "title": {
      "session.idle": {
        "value": "OpenCode"
      },
      "session.error": {
        "value": "OpenCode"
      },
      "permission.asked": {
        "value": "OpenCode"
      }
    },
    "message": {
      "session.idle": {
        "command": "echo \"{project}: Agent finished — https://opencode.whammou.dedyn.io/$(echo -n \"$PWD\" | base64 -w0)/session/{session_id}\""
      },
      "session.error": {
        "command": "echo \"{project}: Agent error — {error} — https://opencode.whammou.dedyn.io/$(echo -n \"$PWD\" | base64 -w0)/session/{session_id}\""
      },
      "permission.asked": {
        "command": "echo \"{project}: Permission {permission_type} for {permission_patterns} — https://opencode.whammou.dedyn.io/$(echo -n \"$PWD\" | base64 -w0)/session/{session_id}\""
      }
    }
  }
}
