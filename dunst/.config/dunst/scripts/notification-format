#!/usr/bin/env sh
# notification-format
#
# Called by [raw-notification] catch-all rule.
# Suppressed raw notification → enriched display notification.
#
# Loop prevention: skip if appname already has display- prefix.
# Specific handlers: skip if category = "raw.handled" (call, clock, etc.).

# Loop prevention — skip display notifications re-entering the pipeline
case "$DUNST_APP_NAME" in display-*) exit 0 ;; esac

# Skip notifications already handled by specific rules (call, clock, etc.)
[ "$DUNST_CATEGORY" = "raw.handled" ] && exit 0

# Forward original urgency (lowercased for dunstify), stack tag, and progress bar hint
urgency_args=""
[ -n "$DUNST_URGENCY" ] && urgency_args="-u $(echo "$DUNST_URGENCY" | tr '[:upper:]' '[:lower:]')"

progress_args=""
[ -n "$DUNST_PROGRESS" ] && progress_args="-h int:value:$DUNST_PROGRESS"

stack_args=""
[ -n "$DUNST_STACK_TAG" ] && stack_args="-h string:x-dunst-stack-tag:$DUNST_STACK_TAG"

# Forward category so DND tiers (04-dnd.conf) can match on display notifications
category_args=""
[ -n "$DUNST_CATEGORY" ] && category_args="-c $DUNST_CATEGORY"

# qutebrowser: domain as summary, sender prefix in body
if [ "$DUNST_APP_NAME" = "qutebrowser" ]; then
    # Extract domain from URL in body
    domain=$(echo "$DUNST_BODY" | grep -oP 'https?://\K[^/"]+' | head -1)
    [ -z "$domain" ] && domain="$DUNST_SUMMARY"

    # Strip HTML, drop first line (URL), remove linebreaks, trim whitespace → message text
    msg=$(echo "$DUNST_BODY" | sed 's/<[^>]*>//g' | sed '1d' | tr -d '\n' | sed 's/^[[:space:]]*//')
    [ -z "$msg" ] && msg=$(echo "$DUNST_BODY" | sed 's/<[^>]*>//g')

    dunstify \
      -a "display-$DUNST_APP_NAME" \
      $urgency_args \
      $progress_args \
      $stack_args \
      $category_args \
      "$domain" \
      "<b>$DUNST_SUMMARY</b>: $msg"
    exit 0
fi

# Enrich body: bold the first colon-separated label (e.g. "AppName: msg" → "AppName: msg")
formatedBody=$(echo "$DUNST_BODY" | perl -pe 's/^(?!https?)([^<>]*):/<b>$1<\/b>:/')

# Re-send as display notification with display- prefixed appname
dunstify \
  -a "display-$DUNST_APP_NAME" \
  $urgency_args \
  $progress_args \
  $stack_args \
  $category_args \
  "$DUNST_SUMMARY" \
  "$formatedBody"
