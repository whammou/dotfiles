#!/usr/bin/env bash

# Send a substitute notification that contains actions
dunst_action=$(
  dunstify \
    -a "display-$DUNST_APP_NAME" \
    -A "accept, Accept incoming call" \
    -A "reject, Reject incoming call" \
    -h "string:x-dunst-stack-tag:call" \
    -c "call.request" \
    "$DUNST_SUMMARY" "$DUNST_BODY!"
)

# Define Actions
case $dunst_action in
"reject")
  ntfy pub \
    -t "Phone Action" \
    "android-socket" \
    "!PHONE:REJECT"
  ;;
"accept")
  ntfy pub \
    -t "Phone Action" \
    "android-socket" \
    "!PHONE:ACCEPT"
  ;;
esac
