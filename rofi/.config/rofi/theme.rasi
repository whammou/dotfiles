/*
 * ROFI theme — fzf-lua-mimic inspired
 *
 * Modular — imports palette + component partials.
 * Edit the individual .rasi files to tweak each section.
 */

configuration {
  matching: "fuzzy";
  sort: true;
  sorting-method: "fzf";

  drun {
    display-name: "";
  }

  run {
    display-name: "";
  }

  window {
    display-name: "";
  }

  timeout {
    action: "kb-cancel";
  }
}

@import "palette"
@import "window"
@import "inputbar"
@import "elements"
@import "scrollbar"