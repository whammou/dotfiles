# Display / Layout: {{{
tabstop 8
indent_incr 4
maxcols 0
pixel_per_char 7
pixel_per_line 14
frame 0
# }}}

# Tab Behavior: {{{
target_self 0
open_tab_blank 0
open_tab_dl_list 0
# }}}

# Link Info: {{{
display_link 0
display_link_number 0
decode_url 0
display_lineinfo 0
display_column_number 0
# }}}

# External Programs: {{{
ext_dirlist 1
dirlist_cmd file:///$LIB/dirlist.cgi
use_dictcommand 1
dictcommand file:///$LIB/w3mdict.cgi
dictprompt (dictionary)!
# }}}

# Display / Layout: {{{
multicol 1
alt_entity 0
graphic_char 2
display_borders 1
disable_center 0
fold_textarea 0
fold_pre 0
display_ins_del 1
ignore_null_img_alt 1
view_unseenobject 0
# }}}

# Image: {{{
display_image 0
pseudo_inlines 0
auto_image 0
max_load_image 0
ext_image_viewer 1
image_scale 100
inline_img_protocol 0
imgdisplay mpv --profile=image
image_map_list 1
# }}}

# Display / Layout: {{{
fold_line 1
show_lnum 0
show_srch_str 1
message_delay 2
label_topline 0
nextpage_topline 0
# }}}

# Colors: {{{
color 1
high-intensity 0
basic_color terminal
anchor_color blue
image_color green
form_color red
mark_color cyan
bg_color terminal
active_style 1
active_color cyan
visited_anchor 1
visited_color magenta
# }}}

# Display / Layout: {{{
pagerline 10000
# }}}

# History & Navigation: {{{
use_history 1
history 100
save_hist 1
confirm_qq 0
exit_on_last 0
close_tab_back 0
mark 0
# }}}

# Input: {{{
emacs_like_lineedit 0
rl_paste 0
space_autocomplete 0
vi_prec_num 1
# }}}

# History & Navigation: {{{
mark_all_pages 0
# }}}

# Search: {{{
wrap_search 0
ignorecase_search 1
smartcase_search 0
# }}}

# Input: {{{
use_mouse 0
reverse_mouse 0
relative_wheel_scroll 0
relative_wheel_scroll_ratio 30
fixed_wheel_scroll_count 5
# }}}

# Display / Layout: {{{
clear_buffer 1
decode_cte 0
auto_uncompress 0
preserve_timestamp 1
# }}}

# External Programs: {{{
keymap_file keymap
document_root 
personal_document_root 
cgi_bin 
index_file 
tmp_dir 
dl_dir 
mime_types ~/.mime.types, /usr/etc/mime.types
mailcap ~/.w3m/mailcap, /usr/etc/w3m/mailcap
urimethodmap ~/.w3m/urimethodmap, /usr/etc/w3m/urimethodmap
editor /usr/sbin/nvim
mailto_options 1
mailer /usr/sbin/neomutt
extbrowser /usr/sbin/qutebrowser
extbrowser2 
extbrowser3 
extbrowser4 
extbrowser5 
extbrowser6 
extbrowser7 
extbrowser8 
extbrowser9 
bgextviewer 1
use_lessopen 0
passwd_file ~/.w3m/passwd
disable_secret_security_check 0
ftppasswd 
ftppass_hostnamegen 1
pre_form_file ~/.w3m/pre_form
siteconf_file ~/.w3m/siteconf
# }}}

# User-Agent / Headers: {{{
user_agent Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
no_referer 0
cross_origin_referer 1
accept_language en;q=1.0
accept_encoding gzip, compress, bzip2, deflate
accept_media text/html, text/*;q=0.5, image/*
# }}}

# Network / URL: {{{
argv_is_url 1
retry_http 1
default_url 1
follow_redirection 10
meta_refresh 0
localhost_only 0
dns_order 0
# }}}

# NNTP / News: {{{
nntpserver 
nntpmode 
max_news 50
# }}}

# Proxy: {{{
use_proxy 1
http_proxy 
https_proxy 
gopher_proxy 
ftp_proxy 
no_proxy 
noproxy_netaddr 1
# }}}

# Network / URL: {{{
no_cache 0
# }}}

# SSL / TLS: {{{
ssl_forbid_method 2, 3, t, 5
ssl_min_version TLSv1.2
ssl_cipher 
ssl_verify_server 1
ssl_cert_file 
ssl_key_file 
ssl_ca_path 
ssl_ca_file 
ssl_ca_default 1
# }}}

# Cookie: {{{
use_cookie 1
show_cookie 0
accept_cookie 1
accept_bad_cookie 0
cookie_reject_domains 
cookie_accept_domains 
cookie_avoid_wrong_number_of_dots 
# }}}

# Charset / i18n: {{{
display_charset UTF-8
document_charset UTF-8
auto_detect 2
system_charset UTF-8
follow_locale 1
ext_halfdump 0
use_wide 1
use_combining 1
east_asian_width 0
use_language_tag 1
ucs_conv 1
pre_conv 0
search_conv 1
fix_width_conv 1
use_gb12345_map 0
use_jisx0201 0
use_jisc6226 0
use_jisx0201k 0
use_jisx0212 0
use_jisx0213 0
strict_iso2022 1
gb18030_as_ucs 0
simple_preserve_space 0
zero_based_link_no 0
# }}}

