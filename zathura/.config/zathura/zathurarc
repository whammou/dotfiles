set window-title-basename true
set recolor true
set guioptions None
set selection-clipboard clipboard
set font "saucecodepro 12"

#map <C-c> set recolor

set default-fg 			    "#abb2bf"
set default-bg 			    "#282c34"

set completion-bg		    "#282c34"
set completion-fg		    "#abb2bf"
set completion-highlight-bg	"#31353f"
set completion-highlight-fg	"#abb2bf"
set completion-group-bg		"#282c34"
set completion-group-fg		"#73b8f1"

set statusbar-fg		    "#abb2bf"
set statusbar-bg		    "#282c34"

set notification-fg		    "#282c34"
set notification-bg		    "#73b8f1"
set notification-error-fg	"#282c34"
set notification-error-bg	"#e86671"
set notification-warning-fg	"#282c34"
set notification-warning-bg	"#e5c07b"

set inputbar-fg			    "#abb2bf"
set inputbar-bg 		    "#282c34"

set recolor-lightcolor		"#282c34"
set recolor-darkcolor		"#abb2bf"

set index-fg			    "#abb2bf"
set index-bg			    "#282c34"
set index-active-fg		    "#abb2bf"
set index-active-bg		    "#31353f"

set render-loading-bg		"#282c34"
set render-loading-fg		"#abb2bf"

set highlight-color		    "rgba(255,0,255,0.5)"
set highlight-active-color	"rgba(0,255,255,0.5)"

