+-- Fetch every calendar at once, then apply the results in configuration order.
+--
+-- A pull is one round trip per calendar, so the sequential loop paid roughly
+-- half a second per configured calendar before the first event was even read.
+-- The requests are independent: they overlap here, while the application of
+-- their results stays sequential and in the same order as before.
+local function pull_calendars(account, calendars, report)
+	if #calendars == 0 then
+		return
+	end
+
+	local provider = providers.for_account(account)
+	local window = sync_window()
+
+	-- One token refresh in front of the fan-out. Refreshing is a write; letting
+	-- every calendar race it would burn the same refresh token in parallel.
+	if account.provider == "google" then
+		local oauth = require("bloocky.sync.oauth")
+		local _, token_err = oauth.access_token(account)
+		if token_err then
+			for _, calendar in ipairs(calendars) do
+				table.insert(report.errors, ("%s: %s"):format(calendar.name, token_err))
+			end
+			return
+		end
+	end
+
+	local results = {}
+	local pending = #calendars
+	local finished, wake = false, nil
+
+	local function settle()
+		finished = true
+		if wake then
+			wake()
+		end
+	end
+
+	for i, calendar in ipairs(calendars) do
+		local co = coroutine.create(function()
+			local cursor = store.calendar_cursor(account.id, calendar.href)
+			local result, err = provider.fetch(account, calendar, cursor, window)
+			results[i] = { result = result, err = err }
+			pending = pending - 1
+			if pending == 0 then
+				settle()
+			end
+		end)
+		local ok, err = coroutine.resume(co)
+		if not ok then
+			results[i] = { err = tostring(err) }
+			pending = pending - 1
+			if pending == 0 then
+				settle()
+			end
+		end
+	end
+
+	if not finished then
+		async.await(function(cb)
+			wake = cb
+			if finished then
+				cb()
+			end
+		end)
+	end
+
+	for i, calendar in ipairs(calendars) do
+		local outcome = results[i]
+		if not outcome then
+			table.insert(report.errors, ("%s: fetch did not complete"):format(calendar.name))
+		elseif outcome.err then
+			table.insert(report.errors, ("%s: %s"):format(calendar.name, outcome.err))
+		else
+			apply_pull(account, calendar, outcome.result, report)
+		end
+	end
+end
