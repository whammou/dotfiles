+def _is_in_past(item: OrgAgendaItem) -> bool:
+    """Report whether an org item starts before the current day or time."""
+    start = item.timestamps[0].start
+    if isinstance(start, datetime):
+        now = datetime.now(tz=start.tzinfo) if start.tzinfo else datetime.now()
+        return start < now
+    return start < datetime.now().date()
+
+
+def _id_map_path(state_file: Path) -> Path:
+    """Return the path of the org ID to event UID map of a calendar."""
+    return state_file.with_suffix(".map.json")
+
+
+def _load_id_map(state_file: Path) -> dict[str, str]:
+    """Load the org ID to event UID map, tolerating a missing or broken file."""
+    try:
+        data = json.loads(_id_map_path(state_file).read_text())
+    except (OSError, ValueError):
+        return {}
+    return data if isinstance(data, dict) else {}
+
+
+def _save_id_map(state_file: Path, agenda: OrgAgendaFile) -> None:
+    """Merge the org ID to event UID pairs of this run into the map file."""
+    mapping = _load_id_map(state_file)
+    for item in agenda.items:
+        item_id = item.properties.get("ID")
+        item_uid = item.properties.get("UID")
+        if item_id and item_uid:
+            mapping[item_id] = item_uid
+    path = _id_map_path(state_file)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(mapping, indent=0, sort_keys=True))
+
+
+def _resolve_uid(item: OrgAgendaItem, id_map: dict[str, str]) -> str | None:
+    """Return the event UID known for an org item, if any."""
+    if item.uid:
+        return item.uid
+    item_id = item.properties.get("ID")
+    if not item_id:
+        return None
+    return id_map.get(item_id)
+
+
+def _khal_item_outside_window(context: SyncContext, uid: str) -> OrgAgendaItem | None:
+    """Load the khal agenda item of a known UID outside the listed date range."""
+    khal_format = get_khal_format()
+    environment = {"calendars": context.khal_calendar.config["calendars"]}
+    events = [
+        event
+        for event in context.khal_calendar.get_events(uid)
+        if event.calendar == context.calendar
+    ]
+    if not events:
+        return None
+    content = "\n".join(
+        khal_format.format(
+            **event.attributes(
+                relative_to=event.start_local,
+                env=environment,
+                colors=False,
+            )
+        )
+        for event in sorted(events)
+    )
+    agenda = OrgAgendaFile.from_str(content).apply_rrules()
+    item = agenda.get_item(uid)
+    if item is not None:
+        context.khal_agenda.items.append(item)
+    return item
+
+
+def _match_state_item(
+    context: SyncContext,
+    item: OrgAgendaItem,
+) -> OrgAgendaItem | None:
+    """Find the state entry of an org item that was pushed by an earlier run."""
+    if item.uid:
+        return context.state_agenda.get_item(item.uid)
+    if not item.timestamps:
+        return None
+    start = item.timestamps[0].start
+    for candidate in context.state_agenda.items:
+        if (
+            candidate.title == item.title
+            and candidate.timestamps
+            and candidate.timestamps[0].start == start
+        ):
+            return candidate
+    return None
+
+
+def _norm_text(text: str | None) -> str:
+    """Collapse whitespace so khal and org descriptions compare reliably."""
+    return " ".join((text or "").split())
+
+
+def _norm_span(timestamp) -> tuple:
+    """Return a start and end pair that matches khal's all-day convention."""
+    start = timestamp.start
+    end = timestamp.end
+    if isinstance(start, datetime):
+        return (start, end)
+    return (start, end or start + timedelta(days=1))
+
+
+def _same_content(a: OrgAgendaItem, b: OrgAgendaItem) -> bool:
+    """Report whether two agenda items hold the same pushed content."""
+    if a.title != b.title or _norm_text(a.description) != _norm_text(b.description):
+        return False
+    if len(a.timestamps) != len(b.timestamps):
+        return False
+    return all(
+        _norm_span(x) == _norm_span(y) for x, y in zip(a.timestamps, b.timestamps)
+    )
+
+
