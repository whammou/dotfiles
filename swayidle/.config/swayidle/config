timeout 180 'brightnessctl --save && brightnessctl set 0%' resume 'brightnessctl --restore'
timeout 180 '! playerctl status 2>/dev/null | rg -q "Playing" && swaylock -f'
timeout 900 '! playerctl status 2>/dev/null | rg -q "Playing" && ([ "$(cat /sys/class/power_supply/AC/online)" = "0" ] && systemctl suspend-then-hibernate)'
before-sleep 'swaylock -f'
