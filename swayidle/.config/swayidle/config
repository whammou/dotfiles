timeout 180 '! playerctl status 2>/dev/null | rg -q "Playing" && ! pactl list sink-inputs 2>/dev/null | rg -q "Corked: no" && (brightnessctl --save && brightnessctl set 0%)' resume 'brightnessctl --restore'
timeout 360 '! playerctl status 2>/dev/null | rg -q "Playing" && ! pactl list sink-inputs 2>/dev/null | rg -q "Corked: no" && keyd reload && swaylock -f' resume 'brightnessctl --restore'
timeout 900 '! playerctl status 2>/dev/null | rg -q "Playing" && ! pactl list sink-inputs 2>/dev/null | rg -q "Corked: no" && ([ "$(cat /sys/class/power_supply/AC/online)" = "0" ] && systemctl suspend-then-hibernate)'
before-sleep 'swaylock -f'
