# wl-kbptr can be configured with a configuration file.
# The file location can be passed with the -c parameter.
# Othewise the `$XDG_CONFIG_HOME/wl-kbptr/config` file will
# be loaded if it exits. Below is the default configuration.

[general]
home_row_keys=
modes=tile,bisect
cancellation_status_code=1

[mode_tile]
label_color=#21252bff
label_select_color=#98c37988
unselectable_bg_color=#21252b66
selectable_bg_color=#98c37988
selectable_border_color=#98c379cc
label_font_family=sans-serif
label_font_size=8 50% 100
label_symbols=asdfghjkl

[mode_floating]
source=stdin
label_color=#21252bff
label_select_color=#98c37988
unselectable_bg_color=#5c637099
selectable_bg_color=#98c37988
selectable_border_color=#98c379cc
label_font_family=sans-serif
label_font_size=17 50% 100
label_symbols=asdfghjkl

[mode_bisect]
label_color=#21252bff
label_font_size=20
label_font_family=sans-serif
label_padding=12
pointer_size=20
pointer_color=#98c379ff
unselectable_bg_color=#21252b66
even_area_bg_color=#98c37944
even_area_border_color=#98c37988
odd_area_bg_color=#c678dd44
odd_area_border_color=#c678dd88
history_border_color=#5c637099

[mode_split]
pointer_size=20
pointer_color=#98c379ff
bg_color=#21252b66
area_bg_color=#98c37988
vertical_color=#98c379cc
horizontal_color=#98c379cc
history_border_color=#5c637099

[mode_click]
button=left
