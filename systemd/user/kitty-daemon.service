[Unit]
Description=kitty single-instance daemon (warm terminal windows)
Documentation=https://sw.kovidgoyal.net/kitty/
After=qtile-session.target
PartOf=qtile-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/kitty-daemon-run
Restart=on-failure
RestartSec=1
Environment=WAYLAND_DISPLAY=wayland-0
Environment=DISPLAY=:0
Slice=session.slice

[Install]
WantedBy=qtile-session.target
