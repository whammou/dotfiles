# ==============================================================================
# Extension: Subscribe to the channel of the currently selected video
#
# Replaces core's stub __menu_media_actions_subscribe_to_channel(), which only
# reports "contribute to the project by adding this feature". This version adds
# the channel to the local subscriptions file (my/subscriptions.json -- the same
# store yt-x's channel browser reads) and opens the channel page so you can hit
# Subscribe on your YouTube account.
#
# Update-safe by design:
#   * yields automatically once core implements the action for real
#     (positive detection: the stub is the only body containing
#     TXT_MENU_MEDIA_ACTIONS_SUBSCRIBE_UNSUPPORTED)
#   * only relies on long-stable core surface: STATE_CURRENT_VIDEO,
#     CLI_MY_SUBSCRIPTIONS_FILE, ui_confirm/ui_notify/ui_notify_error, _util_open
#   * the subscriptions file is replaced atomically and never clobbered when jq
#     fails
#   * duplicate detection matches url / channel_url / channel_id / id after URL
#     normalisation, so the same channel reached via /channel/UC..., /@handle or
#     through a video is not added twice
# ==============================================================================

# ---- strings (define TXT_SUBSCRIBE_CHANNEL_* before autoloading to translate)
: "${TXT_SUBSCRIBE_CHANNEL_CONFIRM:=Subscribe to %s?}"
: "${TXT_SUBSCRIBE_CHANNEL_CANCELLED:=Subscription cancelled}"
: "${TXT_SUBSCRIBE_CHANNEL_ALREADY:=Already subscribed to %s}"
: "${TXT_SUBSCRIBE_CHANNEL_DONE:=Subscribed locally — browser opened: click Subscribe on YouTube}"
: "${TXT_SUBSCRIBE_CHANNEL_DONE_NO_BROWSER:=Subscribed to %s}"
: "${TXT_SUBSCRIBE_CHANNEL_WRITE_ERROR:=Could not update %s}"
: "${TXT_MENU_MEDIA_ACTIONS_CHANNEL_NOT_FOUND:=Could not determine a channel URL for this video}"

# ---- helpers -----------------------------------------------------------------

# Positive detection only: 0 when core has a real (non-stub) implementation.
__subscribe_channel_core_is_real() {
  local script
  local body

  script="${YT_X_SCRIPT:-$0}"
  [ -s "$script" ] || return 1
  body="$(awk '
    /^__menu_media_actions_subscribe_to_channel[[:space:]]*\(\)/ { infn = 1; next }
    infn && /^}/ { exit }
    infn { print }
  ' "$script" 2>/dev/null)"
  [ -n "$body" ] || return 1
  printf '%s' "$body" | grep -q 'SUBSCRIBE_UNSUPPORTED' && return 1
  return 0
}

# Canonicalise a channel URL so comparisons survive scheme/query/slash variants.
__subscribe_channel_normalize_url() {
  local url

  url="$1"
  case "$url" in //*) url="https:$url" ;; esac
  printf '%s' "$url" |
    sed -e 's#^http://#https://#' -e 's#[?#].*$##' -e 's#/*$##'
}

# ---- implementation ----------------------------------------------------------
__subscribe_channel_impl() {
  local channel_url
  local raw_channel_id
  local uploader_id
  local channel_id
  local channel_title
  local new_entry
  local tmpfile
  local msg

  # ---- resolve the channel URL (same fallbacks as visit_channel) ----
  channel_url="$(printf '%s' "$STATE_CURRENT_VIDEO" | jq -r '.channel_url // .uploader_url // empty')"
  raw_channel_id="$(printf '%s' "$STATE_CURRENT_VIDEO" | jq -r '.channel_id // empty')"
  uploader_id="$(printf '%s' "$STATE_CURRENT_VIDEO" | jq -r '.uploader_id // empty')"

  [ "$channel_url" = "null" ] && channel_url=""
  [ "$raw_channel_id" = "null" ] && raw_channel_id=""
  [ "$uploader_id" = "null" ] && uploader_id=""

  if [ -z "$channel_url" ]; then
    if [ -n "$raw_channel_id" ]; then
      channel_url="https://www.youtube.com/channel/$raw_channel_id"
    elif [ -n "$uploader_id" ]; then
      case "$uploader_id" in
      @*) channel_url="https://www.youtube.com/$uploader_id" ;;
      *) channel_url="https://www.youtube.com/channel/$uploader_id" ;;
      esac
    fi
  fi

  if [ -z "$channel_url" ]; then
    ui_notify_error "$TXT_MENU_MEDIA_ACTIONS_CHANNEL_NOT_FOUND"
    return 1
  fi

  channel_url="$(__subscribe_channel_normalize_url "$channel_url")"

  # ---- canonical channel id: UC... when known, else the @handle ----
  if [ -n "$raw_channel_id" ]; then
    channel_id="${raw_channel_id##*/}"
  elif [ -n "$uploader_id" ]; then
    channel_id="${uploader_id##*/}"
  else
    channel_id=""
  fi

  channel_title="$(printf '%s' "$STATE_CURRENT_VIDEO" | jq -r '.channel // .uploader // empty')"
  if [ -z "$channel_title" ] || [ "$channel_title" = "null" ]; then
    channel_title="$channel_url"
  fi

  # ---- confirm ----
  # shellcheck disable=SC2059
  msg="$(printf "$TXT_SUBSCRIBE_CHANNEL_CONFIRM" "$channel_title")"
  if ! ui_confirm "$msg"; then
    ui_notify "$TXT_SUBSCRIBE_CHANNEL_CANCELLED"
    return 0
  fi

  # ---- already subscribed? match url / channel_url / channel_id / id ----
  # Empty strings are truthy in jq, so never rely on `//` to fall through here.
  if [ -s "$CLI_MY_SUBSCRIPTIONS_FILE" ]; then
    if jq -e --arg url "$channel_url" --arg id "$channel_id" '
        def nu: (. // "")
          | sub("^http://"; "https://")
          | sub("[?#].*$"; "")
          | sub("/+$"; "");
        any(.entries[]?;
              (.url | nu) == $url
           or (.channel_url | nu) == $url
           or ($id != "" and (((.channel_id // "") == $id) or ((.id // "") == $id)))
        )' "$CLI_MY_SUBSCRIPTIONS_FILE" >/dev/null 2>&1; then
      # shellcheck disable=SC2059
      ui_notify "$(printf "$TXT_SUBSCRIBE_CHANNEL_ALREADY" "$channel_title")"
      return 0
    fi
  fi

  # ---- build an entry in yt-dlp flat-playlist shape (menu_channels reads
  #      .title and .url) ----
  if ! new_entry="$(
    printf '%s' "$STATE_CURRENT_VIDEO" | jq -c \
      --arg url "$channel_url" \
      --arg id "$channel_id" \
      --arg title "$channel_title" '
      {
        _type:       "url",
        url:         $url,
        id:          $id,
        ie_key:      "YoutubeTab",
        channel:     (.channel // .uploader // $title),
        uploader:    (.uploader // .channel // $title),
        channel_id:  ($id | if startswith("UC") then . else "" end),
        channel_url: $url,
        title:       $title,
        uploader_id: (.uploader_id // ""),
        uploader_url:(.uploader_url // "")
      }'
  )"; then
    # shellcheck disable=SC2059
    ui_notify_error "$(printf "$TXT_SUBSCRIBE_CHANNEL_WRITE_ERROR" "$CLI_MY_SUBSCRIPTIONS_FILE")"
    return 1
  fi

  # ---- append atomically; never clobber the store on a jq error ----
  tmpfile="$CLI_MY_SUBSCRIPTIONS_FILE.tmp.$$"
  if [ -s "$CLI_MY_SUBSCRIPTIONS_FILE" ]; then
    jq -c --argjson e "$new_entry" '.entries += [$e]' \
      "$CLI_MY_SUBSCRIPTIONS_FILE" >"$tmpfile" 2>/dev/null || true
  else
    printf '{"entries":[]}' |
      jq -c --argjson e "$new_entry" '.entries += [$e]' >"$tmpfile" 2>/dev/null || true
  fi

  if [ ! -s "$tmpfile" ] || ! jq -e '.entries' "$tmpfile" >/dev/null 2>&1; then
    rm -f "$tmpfile"
    # shellcheck disable=SC2059
    ui_notify_error "$(printf "$TXT_SUBSCRIBE_CHANNEL_WRITE_ERROR" "$CLI_MY_SUBSCRIPTIONS_FILE")"
    return 1
  fi

  mv "$tmpfile" "$CLI_MY_SUBSCRIPTIONS_FILE"

  # ---- open the channel page so the real Subscribe button is one click away -
  if _util_open "$channel_url"; then
    ui_notify "$TXT_SUBSCRIBE_CHANNEL_DONE"
  else
    # shellcheck disable=SC2059
    ui_notify "$(printf "$TXT_SUBSCRIBE_CHANNEL_DONE_NO_BROWSER" "$channel_title")"
    printf '[subscribe-channel] Failed to open browser for: %s\n' "$channel_url" \
      >>"${TMPDIR:-/tmp}/yt-x.log" 2>/dev/null || true
  fi
}

# ---- install the override only while core's version is still the stub -------
if ! __subscribe_channel_core_is_real; then
  __menu_media_actions_subscribe_to_channel() {
    __subscribe_channel_impl "$@"
  }
fi
